PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"

# --- Non-Python toolchain: the pixi env holds CUDA, compilers, native libs. ---
PIXI_ENV="${PROJECT_ROOT}/.pixi/envs/default"

# --- CUDA: prefer the pixi-managed toolkit, then in-repo third_party/cuda, then system. ---
if [ -x "${PIXI_ENV}/bin/nvcc" ]; then
  export CUDA_HOME="${PIXI_ENV}"
elif [ -d "${PROJECT_ROOT}/third_party/cuda" ]; then
  export CUDA_HOME="${PROJECT_ROOT}/third_party/cuda"
else
  export CUDA_HOME="${CUDA_HOME:-/usr/local/cuda}"
fi

# --- PATH: pixi bin + project CUDA + project venv first, then existing PATH. ---
export PATH="${PIXI_ENV}/bin:${CUDA_HOME}/bin:${PROJECT_ROOT}/.venv/bin:${PATH}"

# --- Loader: pixi libs + project CUDA libs + build dir for fresh .so files. ---
export LD_LIBRARY_PATH="${PIXI_ENV}/lib:${CUDA_HOME}/lib64:${PROJECT_ROOT}/build:${LD_LIBRARY_PATH:-}"

# --- CMake: let find_package() see pixi-installed libraries and headers. ---
export CMAKE_PREFIX_PATH="${PIXI_ENV}:${CMAKE_PREFIX_PATH:-}"

